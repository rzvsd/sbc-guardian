{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardian:SbcChallenge",
  "title": "SbcChallenge",
  "type": "object",
  "required": ["id", "name", "format", "requirements"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "format": { "$ref": "sbc-format.json" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    }
  },
  "additionalProperties": false
}
