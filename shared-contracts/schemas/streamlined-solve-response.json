{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guardian:StreamlinedSolveResponse",
  "title": "StreamlinedSolveResponse",
  "type": "object",
  "required": ["contract_version", "suggestion"],
  "properties": {
    "contract_version": { "type": "integer", "const": 1 },
    "suggestion": {
      "type": "object",
      "required": ["players", "rating"],
      "properties": {
        "players": { "type": "array", "items": { "type": "string" } },
        "rating": { "type": "integer" },
        "cost": { "type": "number" }
      }
    }
  },
  "additionalProperties": false
}
